---
// Marquee: a looping row of words or logos (translateX only, plain CSS, no GSAP). It sits directly below the hero
// in its own band (src/sections/marquee/MarqueeBand.astro), never inside the hero (Lou, 2026-11-07). It moves past
// 5 seconds on its own. No pause button (Lou, 2026-11-22); it still stops on hover and focus. Reduced
// motion or no JS: a static, wrapping row. Never put information only here.
interface Props { items: string[]; speed?: number; class?: string }
const { items, speed = 40, class: cls = '' } = Astro.props;
const list = [...items, ...items];
---
<div class:list={['fx-marquee', cls]} data-fx="marquee" style={`--speed:${speed}s`}>
  <div class="fx-marquee-track" aria-hidden="true">
    <ul>{list.map((t) => <li>{t}</li>)}</ul>
  </div>
  <ul class="fx-marquee-static sr-only">{items.map((t) => <li>{t}</li>)}</ul>
</div>


<style>
  .fx-marquee { position: relative; overflow: hidden; padding: 18px 0; border-top: 1px solid rgb(255 255 255 / 0.14); }
  .fx-marquee-track { display: flex; width: max-content; }
  .fx-marquee ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .fx-marquee li { display: flex; align-items: center; gap: 28px; padding-right: 28px; white-space: nowrap; font-family: var(--f-display); font-weight: var(--w-heading); font-size: clamp(1rem, 0.9rem + 0.6vw, 1.35rem); letter-spacing: 0.06em; text-transform: uppercase; }
  .fx-marquee li::after { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.motion) .fx-marquee-track { animation: fx-mq var(--speed) linear infinite; }
    :global(html.motion) .fx-marquee:hover .fx-marquee-track, :global(html.motion) .fx-marquee:focus-within .fx-marquee-track { animation-play-state: paused; }
  }
  @keyframes fx-mq { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .fx-marquee-track { width: 100%; }
    .fx-marquee-track ul { flex-wrap: wrap; justify-content: center; row-gap: 8px; }
    .fx-marquee-track li:nth-child(n + 1) { display: none; }
    .fx-marquee-track li:nth-child(-n + 6) { display: flex; }
    }
</style>
