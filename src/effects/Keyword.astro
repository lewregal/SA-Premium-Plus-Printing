---
// Keyword: the hero's motion moment, CSS only. One word or short phrase inside the headline gets a mark that
// animates around it while the word itself stays real text, in place, fully visible from the first frame:
//   highlighter  a marker bar sweeps in behind the lower third of the word (scaleX, transform only)
//   underline    a hand drawn stroke draws itself under the word (stroke-dashoffset on one small path, paint only)
//   fill         a band of accent color passes through the word and settles on the accent (background position, paint only)
// No script, no GSAP: a keyframe animation that starts on page load (html.motion) and settles within about 1.5s.
// Reduced motion or no JS: the finished mark. The word comes from the page's own data: the service or the city
// the Google Business Profile ranks for (see src/effects/keyword.ts and the `keyword` prop on every hero).
// Floor: one Keyword per hero. Ceiling: two, the second with `lead={false}` so it follows the first.
interface Props { text: string; variant?: 'highlighter' | 'underline' | 'fill'; lead?: boolean; color?: string; class?: string }
const { text, variant = 'highlighter', lead = true, color, class: cls = '' } = Astro.props;
---
<span class:list={['fx-kw', `fx-kw-${variant}`, { 'is-second': !lead }, cls]} data-fx="keyword" data-kw={variant} style={color ? `--kw:${color}` : undefined}>
  {variant === 'highlighter' && <span class="fx-kw-bar" aria-hidden="true"></span>}
  <span class="fx-kw-text">{text}</span>
  {variant === 'underline' && <svg class="fx-kw-line" viewBox="0 0 220 28" preserveAspectRatio="none" aria-hidden="true"><path d="M4 20 C 50 8, 120 4, 216 13" /></svg>}
</span>

<style>
  .fx-kw { position: relative; display: inline-block; isolation: isolate; --kw-delay: 0.35s; }
  .fx-kw.is-second { --kw-delay: 0.85s; }
  .fx-kw-text { position: relative; z-index: 1; }

  /* highlighter: bar behind the lower third, already full width; the animation sweeps it in */
  .fx-kw-highlighter { padding: 0 0.08em; --kw: var(--accent-soft); }
  :global(.on-dark) .fx-kw-highlighter { --kw: rgb(255 255 255 / 0.18); }
  .fx-kw-bar { position: absolute; left: 0; right: 0; bottom: 0.04em; height: 0.4em; z-index: 0; border-radius: 2px; background: var(--kw); transform-origin: left center; }
  :global(html.motion) .fx-kw-highlighter .fx-kw-bar { animation: fx-kw-sweep 0.7s var(--ease) var(--kw-delay) both; }
  @keyframes fx-kw-sweep { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* underline: a drawn stroke under the word, already drawn; the animation draws it left to right */
  .fx-kw-underline { --kw: var(--accent); }
  :global(.on-dark) .fx-kw-underline { --kw: var(--star); }
  .fx-kw-line { position: absolute; left: -2%; bottom: -0.08em; width: 104%; height: 0.22em; overflow: visible; pointer-events: none; }
  .fx-kw-line path { fill: none; stroke: var(--kw); stroke-width: 7; stroke-linecap: round; stroke-dasharray: 240; stroke-dashoffset: 0; }
  :global(html.motion) .fx-kw-underline .fx-kw-line path { animation: fx-kw-draw 0.8s ease-out var(--kw-delay) both; }
  @keyframes fx-kw-draw { from { stroke-dashoffset: 240; } to { stroke-dashoffset: 0; } }

  /* fill: the word is colored by a gradient the whole time, so it is visible in the first frame; the band passes once */
  .fx-kw-fill { --kw: var(--accent); --kw-base: var(--brand); color: var(--kw); }
  :global(.on-dark) .fx-kw-fill { --kw: var(--star); --kw-base: var(--on-deep-strong); }
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    :global(html.motion) .fx-kw-fill .fx-kw-text { color: transparent; -webkit-text-fill-color: transparent; background-image: linear-gradient(100deg, var(--kw) 0 38%, color-mix(in srgb, var(--kw) 55%, white) 46%, var(--kw-base) 54% 100%); background-size: 280% 100%; background-position: 100% 0; background-repeat: no-repeat; -webkit-background-clip: text; background-clip: text; animation: fx-kw-pass 0.9s cubic-bezier(0.45, 0.05, 0.25, 1) var(--kw-delay) both; }
  }
  @keyframes fx-kw-pass { from { background-position: 100% 0; } to { background-position: 0 0; } }

  @media (prefers-reduced-motion: reduce) {
    .fx-kw-bar, .fx-kw-line path, .fx-kw-fill .fx-kw-text { animation: none !important; }
    .fx-kw-bar { transform: none !important; }
    .fx-kw-line path { stroke-dashoffset: 0 !important; }
    .fx-kw-fill .fx-kw-text { color: var(--kw) !important; -webkit-text-fill-color: var(--kw) !important; background: none !important; }
  }
</style>
