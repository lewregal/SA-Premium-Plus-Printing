---
// One page per served town ("{Category} near {Town}, TX"). The starter builds one per SITE.areas entry.
import Base from '../../layouts/Base.astro';
import Banner from '../../sections/banner/Banner.astro';
import AreaMap from '../../sections/areas/AreaMap.astro';
import CardGrid from '../../sections/paper/CardGrid.astro';
import ReviewGrid from '../../sections/reviews/ReviewGrid.astro';
import WashCta from '../../sections/cta/WashCta.astro';
import { SITE } from '../../data/site';
export function getStaticPaths() {
  return SITE.areas.map((a) => ({ params: { town: a.toLowerCase().replace(/\s+/g, '-') }, props: { area: a } }));
}
const { town } = Astro.params; const { area } = Astro.props;
---
<Base title={`${SITE.category} near ${area}, ${SITE.region} | ${SITE.short}`} description={`${SITE.short} serves ${area}, ${SITE.region}. Call ${SITE.phone}.`} path={`/service-areas/${town}`}>
  <Banner crumbs={[{ name: 'Service areas', href: '/service-areas' }, { name: area, href: `/service-areas/${town}` }]} eyebrow={`${SITE.category} near ${area}, ${SITE.region}`} headline={`Same crew, out in ${area}`} line="We are on this side of town most weeks. Here is what we do there and when we can come." />
  <AreaMap area={area} headline={`${SITE.category} near ${area}, ${SITE.region}`} />
  <CardGrid eyebrow={`Work in ${area}`} headline="What neighbors call us for" />
  <ReviewGrid headline={`What ${area} customers say`} />
  <WashCta />
</Base>
