---
// The kit: every section variant and every effect, rendered with the sample tokens and a visible label, so Lou can
// browse in a browser and point by name. Not in the sitemap, noindex. Labels match CATALOG.md names.
import Base from '../layouts/Base.astro';
import SplitPhoto from '../sections/hero/SplitPhoto.astro';
import FullBleed from '../sections/hero/FullBleed.astro';
import KineticType from '../sections/hero/KineticType.astro';
import EditorialGrid from '../sections/hero/EditorialGrid.astro';
import ReviewLed from '../sections/hero/ReviewLed.astro';
import Banner from '../sections/banner/Banner.astro';
import TrustLine from '../sections/trust/TrustLine.astro';
import CardGrid from '../sections/paper/CardGrid.astro';
import Narrative from '../sections/mark/Narrative.astro';
import GR1 from '../sections/reviews/GR1.astro';
import GR2 from '../sections/reviews/GR2.astro';
import GR3 from '../sections/reviews/GR3.astro';
import AreaChips from '../sections/areas/AreaChips.astro';
import AreaMap from '../sections/areas/AreaMap.astro';
import ServicesGrid from '../sections/services/ServicesGrid.astro';
import Faq from '../sections/faq/Faq.astro';
import WashCta from '../sections/cta/WashCta.astro';
import MarqueeBand from '../sections/marquee/MarqueeBand.astro';
import KineticBand from '../sections/kinetic/KineticBand.astro';
import Keyword from '../effects/Keyword.astro';
import ScrambleText from '../effects/ScrambleText.astro';
import SplitLineReveal from '../effects/SplitLineReveal.astro';
import WordStagger from '../effects/WordStagger.astro';
import MaskReveal from '../effects/MaskReveal.astro';
import ScribbleUnderline from '../effects/ScribbleUnderline.astro';
import HighlighterBar from '../effects/HighlighterBar.astro';
import OutlinedToSolid from '../effects/OutlinedToSolid.astro';
import WeightShift from '../effects/WeightShift.astro';
import Marquee from '../effects/Marquee.astro';
import CounterRoll from '../effects/CounterRoll.astro';
import ScriptAccent from '../effects/ScriptAccent.astro';
import GradientSweep from '../effects/GradientSweep.astro';

const sections = [
  ['hero/SplitPhoto', 'Split photo hero'], ['marquee/MarqueeBand', 'Marquee band'], ['hero/FullBleed', 'Full bleed hero'], ['hero/KineticType', 'Kinetic type hero'],
  ['kinetic/KineticBand', 'Kinetic band'], ['hero/EditorialGrid', 'Editorial grid hero'], ['hero/ReviewLed', 'Review led hero'], ['banner/Banner', 'Inner page banner'],
  ['trust/TrustLine', 'Trust line'], ['paper/CardGrid', 'Paper card grid'], ['mark/Narrative', 'Mark narrative'],
  ['reviews/GR1', 'GR1 Google reviews carousel'], ['reviews/GR2', 'GR2 Google reviews grid'], ['reviews/GR3', 'GR3 Google reviews wall'], ['areas/AreaChips', 'Area chips'], ['areas/AreaMap', 'Area map'],
  ['services/ServicesGrid', 'Services grid'], ['faq/Faq', 'FAQ'], ['cta/WashCta', 'Wash CTA'],
];
const effects = ['Keyword', 'SplitLineReveal', 'WordStagger', 'MaskReveal', 'ScribbleUnderline', 'HighlighterBar', 'OutlinedToSolid', 'ScrambleText', 'WeightShift', 'Marquee', 'CounterRoll', 'ScriptAccent', 'GradientSweep'];
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<Base multiH1 title="Rigal starter kit" description="Every section variant and effect in the Rigal Astro starter, with labels." path="/kit" noindex>
  <section class="kit-intro ground-card">
    <div class="wrap">
      <span class="eyebrow pill">Rigal Astro starter</span>
      <h1 class="h1">The kit</h1>
      <p class="lede">Every section variant and effect, with the sample tokens. Point at a label and name it. Fingerprints live in CATALOG.md.</p>
      <nav aria-label="Kit index" class="kit-index">
        <ul class="chips">{sections.map(([p, n]) => <li><a href={`#s-${slug(p)}`}>{n}</a></li>)}</ul>
        <ul class="chips">{effects.map((e) => <li><a href={`#e-${slug(e)}`}>{e}</a></li>)}</ul>
      </nav>
    </div>
  </section>

  <div class="kit-item" id="s-hero-splitphoto"><span class="kit-label">hero/SplitPhoto</span><SplitPhoto /></div>
  <div class="kit-item" id="s-marquee-marqueeband"><span class="kit-label">marquee/MarqueeBand</span><MarqueeBand items={['Roof repair', 'Replacement', 'Storm inspection', 'Gutters', 'Metal roofing']} /></div>
  <div class="kit-item" id="s-hero-fullbleed"><span class="kit-label">hero/FullBleed</span><FullBleed /></div>
  <div class="kit-item" id="s-hero-kinetictype"><span class="kit-label">hero/KineticType</span><KineticType eyebrow="Sports Bar in San Antonio, TX" /></div>
  <div class="kit-item" id="s-kinetic-kineticband"><span class="kit-label">kinetic/KineticBand</span><KineticBand /></div>
  <div class="kit-item" id="s-hero-editorialgrid"><span class="kit-label">hero/EditorialGrid</span><EditorialGrid count={12} /></div>
  <div class="kit-item" id="s-hero-reviewled"><span class="kit-label">hero/ReviewLed</span><ReviewLed /></div>
  <div class="kit-item" id="s-banner-banner"><span class="kit-label">banner/Banner</span><Banner /></div>
  <div class="kit-item" id="s-trust-trustline"><span class="kit-label">trust/TrustLine</span><TrustLine /></div>
  <div class="kit-item" id="s-paper-cardgrid"><span class="kit-label">paper/CardGrid</span><CardGrid /></div>
  <div class="kit-item" id="s-mark-narrative"><span class="kit-label">mark/Narrative</span><Narrative /></div>
  <div class="kit-item" id="s-reviews-gr1"><span class="kit-label">reviews/GR1 (carousel)</span><GR1 sample /></div>
  <div class="kit-item" id="s-reviews-gr2"><span class="kit-label">reviews/GR2 (grid)</span><GR2 /></div>
  <div class="kit-item" id="s-reviews-gr3"><span class="kit-label">reviews/GR3 (wall)</span><GR3 sample /></div>
  <div class="kit-item" id="s-areas-areachips"><span class="kit-label">areas/AreaChips</span><AreaChips /></div>
  <div class="kit-item" id="s-areas-areamap"><span class="kit-label">areas/AreaMap</span><AreaMap /></div>
  <div class="kit-item" id="s-services-servicesgrid"><span class="kit-label">services/ServicesGrid</span><ServicesGrid /></div>
  <div class="kit-item" id="s-faq-faq"><span class="kit-label">faq/Faq</span><Faq /></div>
  <div class="kit-item" id="s-cta-washcta"><span class="kit-label">cta/WashCta</span><WashCta /></div>

  <section class="sec ground-paper" aria-labelledby="fx-title">
    <div class="wrap">
      <div class="sec-head"><span class="eyebrow pill">Effects</span><h2 class="h2" id="fx-title">Text and reveal effects</h2><p class="lede">The hero keyword, highlighter, marquee and gradient sweep are plain CSS. Split line, word stagger, scribble, outlined fill, scramble and weight shift run on GSAP, loaded lazily below the hero. Every one fires once on scroll into view and shows its finished state under reduced motion.</p></div>
      <div class="fx-grid">
        <div class="fx" id="e-keyword"><span class="kit-label">effects/Keyword</span><p class="h2">Hero moments: <Keyword text="highlighter" variant="highlighter" />, <Keyword text="underline" variant="underline" lead={false} /> and <Keyword text="color fill" variant="fill" lead={false} /></p><p class="small">CSS only, from first paint, settles in about 1.5 seconds. One per hero, two at most.</p></div>
        <div class="fx" id="e-splitlinereveal"><span class="kit-label">effects/SplitLineReveal</span><SplitLineReveal text="Lines rise out of their own masks, top line first" as="p" class="h2" /></div>
        <div class="fx" id="e-wordstagger"><span class="kit-label">effects/WordStagger</span><WordStagger text="Words rise and fade in one after another, for a lede or a proof line." as="p" class="lede" /></div>
        <div class="fx" id="e-maskreveal"><span class="kit-label">effects/MaskReveal</span><div class="fx-masks"><MaskReveal label="arch" shape="arch" /><MaskReveal label="pitch" shape="pitch" delay={0.15} /><MaskReveal label="chamfer" shape="chamfer" delay={0.3} /></div></div>
        <div class="fx" id="e-scribbleunderline"><span class="kit-label">effects/ScribbleUnderline</span><p class="h2">A stroke draws under <ScribbleUnderline text="the key words" /></p></div>
        <div class="fx" id="e-highlighterbar"><span class="kit-label">effects/HighlighterBar</span><p class="h2">A marker sweeps behind <HighlighterBar text="the phrase that matters" /></p></div>
        <div class="fx" id="e-outlinedtosolid"><span class="kit-label">effects/OutlinedToSolid</span><OutlinedToSolid lines={['Solid line first.', 'Outlined line fills.', 'Same size, same face.']} as="p" class="h1" fill /></div>
        <div class="fx" id="e-scrambletext"><span class="kit-label">effects/ScrambleText</span><p class="h2">Doors open at <ScrambleText text="4 PM" as="strong" chars="upperCase" /></p><p class="small">GSAP ScrambleText, once, below the hero. Bars and auto.</p></div>
        <div class="fx" id="e-weightshift"><span class="kit-label">effects/WeightShift</span><WeightShift text="This headline gains weight as it climbs the screen" as="p" class="h2" /></div>
        <div class="fx on-dark fx-dark" id="e-marquee"><span class="kit-label">effects/Marquee</span><Marquee items={['Pause control', 'Hover pauses', 'Static under reduced motion', 'Sits below the hero']} /></div>
        <div class="fx" id="e-counterroll"><span class="kit-label">effects/CounterRoll</span><div class="fx-counters"><CounterRoll value={12} label="years in the area" /><CounterRoll value={480} suffix="+" label="roofs completed" /><CounterRoll value={5} prefix="" suffix=".0" label="Google rating" /></div></div>
        <div class="fx" id="e-scriptaccent"><span class="kit-label">effects/ScriptAccent</span><div class="fx-script-demo"><p class="h2">A headline</p><ScriptAccent text="with a note beside it" arrow="down" /></div></div>
        <div class="fx" id="e-gradientsweep"><span class="kit-label">effects/GradientSweep</span><p class="h2">Color sweeps once through <GradientSweep text="one phrase" /> and settles</p></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .kit-intro { padding: calc(var(--s-9) + 40px) 0 var(--s-8); }
  .kit-intro .wrap { display: flex; flex-direction: column; gap: var(--s-5); }
  .kit-index { display: flex; flex-direction: column; gap: var(--s-4); }
  .kit-item { position: relative; }
  .kit-label, .fx > .kit-label { position: absolute; left: 12px; top: 12px; z-index: 5; padding: 6px 10px; border-radius: 6px; background: #111; color: #fff; font: 600 12px/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: 0.02em; }
  .fx-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); }
  .fx { position: relative; min-width: 0; overflow: hidden; padding: calc(var(--s-7) + 8px) var(--s-6) var(--s-6); border: 1px solid var(--line); border-radius: var(--r-card); background: var(--card); min-height: 240px; display: flex; flex-direction: column; justify-content: center; gap: var(--s-4); text-align: left; }
  .fx-dark { background: var(--deep); }
  .fx-masks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); width: 100%; }
  .fx-masks :global(.frame) { aspect-ratio: 3 / 4; }
  .fx-counters { display: flex; flex-wrap: wrap; gap: var(--s-6); }
  .fx-script-demo { display: flex; align-items: flex-start; gap: var(--s-5); flex-wrap: wrap; }
  @media (max-width: 900px) { .fx-grid { grid-template-columns: minmax(0, 1fr); } .fx { text-align: center; align-items: center; } .fx > * { max-width: 100%; } .fx-script-demo { justify-content: center; } }
</style>
