---
import Base from '../layouts/Base.astro';
import Banner from '../sections/banner/Banner.astro';
import { SITE } from '../data/site';
---
<Base title={`Thank you | ${SITE.short}`} description="We got your message." path="/thank-you" noindex>
  <Banner crumbs={[{ name: 'Thank you', href: '/thank-you' }]} eyebrow="Message received" headline="Thanks, we will be in touch" line={`We reply during office hours, ${SITE.hours.text}. For anything urgent, call ${SITE.phone}.`} primary={{ label: `Call ${SITE.phone}`, href: `tel:${SITE.phoneE164}` }} proof=" " />
</Base>
