---
// One page per GBP category (GBP Core Alignment), plus Websites. The kicker H1 is the category and city; the big
// line carries the CSS keyword moment on the service word. Data: src/data/categories.ts.
import Base from '../../layouts/Base.astro';
import Banner from '../../sections/banner/Banner.astro';
import Faq from '../../sections/faq/Faq.astro';
import PosterCta from '../../sections/poster/PosterCta.astro';
import SplitLineReveal from '../../effects/SplitLineReveal.astro';
import { SITE } from '../../data/site';
import { ALL, CATEGORIES, itemHref, type Category } from '../../data/categories';
export function getStaticPaths() {
  return ALL.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Category };
const parent = c.parent ? CATEGORIES.find((p) => p.slug === c.parent) : undefined;
const crumbs = [...(parent ? [{ name: parent.label, href: `/${parent.slug}` }] : []), { name: c.label, href: `/${c.slug}` }];
const others = ALL.filter((o) => o.slug !== c.slug);
const url = `${SITE.domain}/${c.slug}`;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', name: c.label, serviceType: c.gbp[0] || c.label, areaServed: { '@type': 'City', name: `${SITE.city}, ${SITE.region}` }, provider: { '@id': `${SITE.domain}/#business` }, url },
    { '@type': 'FAQPage', mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain }, ...crumbs.map((x, i) => ({ '@type': 'ListItem', position: i + 2, name: x.name, item: `${SITE.domain}${x.href}` }))] },
  ],
};
const title = c.web ? `Websites for Local Businesses | ${SITE.short}` : `${c.kicker} | ${SITE.short}`;
---
<Base title={title} description={`${c.line} ${SITE.name}, 4135 Stahl Rd, San Antonio. Call ${SITE.phone}.`} path={`/${c.slug}`} overlayHeader>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <Banner crumbs={crumbs} eyebrow={c.kicker} headline={c.headline} keyword={c.keyword} keywordVariant="fill" line={c.line} media={{ src: c.img }}
    proof={`${SITE.rating} stars from ${SITE.reviewCount} Google reviews`} secondary={{ label: `Call ${SITE.phone}`, href: `tel:${SITE.phoneE164}` }} />
  <section class="sec on-dark">
    <div class="wrap cat-grid">
      <div class="cat-copy">
        <SplitLineReveal text={c.web ? 'What you get' : `What we ${c.slug === 'signs' ? 'make' : 'print'}`} class="poster poster-h2" />
        <ul class="cat-items">
          {c.items.map((it) => <li>{c.web ? <h3 class="poster">{it.name}</h3> : <h3 class="poster"><a href={itemHref(c, it)} aria-current={it.slug === '' ? 'page' : undefined}>{it.name}</a></h3>}<p>{it.text}</p></li>)}
        </ul>
      </div>
      <figure class="cat-photo"><img src={c.img} alt={c.imgAlt} width="800" height="1000" loading="lazy" decoding="async"><figcaption class="tape">{c.label}</figcaption></figure>
    </div>
  </section>
  <section class="sec steps on-dark">
    <div class="wrap">
      <h2 class="poster poster-h2 center">Three ways <span class="g">to order</span></h2>
      <ol class="step-list">
        <li><span class="poster">01</span><h3 class="h3">Book a call</h3><p>Pick a time and we call you to talk through the job.</p><a class="tlink" href="/book">Pick a call time</a></li>
        <li><span class="poster">02</span><h3 class="h3">DM on Instagram</h3><p>Send the idea, a logo or a photo to {SITE.instagram.handle}.</p><a class="tlink" href={SITE.instagram.dm} rel="noopener">Message the shop</a></li>
        <li><span class="poster">03</span><h3 class="h3">Stop by the shop</h3><p>{SITE.address.street}, {SITE.hours.text}.</p><a class="tlink" href="/contact">Get directions and hours</a></li>
      </ol>
    </div>
  </section>
  <Faq eyebrow="Good to know" headline={`${c.label} questions`} items={c.faq} />
  <section class="sec more on-dark">
    <div class="wrap">
      <h2 class="eyebrow pill">More from the shop</h2>
      <ul class="more-list">{others.map((o) => <li><a class:list={{ web: o.web }} href={`/${o.slug}`}>{o.label}<svg aria-hidden="true"><use href="#i-arrow"/></svg></a></li>)}</ul>
    </div>
  </section>
  <PosterCta tape="Got an idea?" text="Let's print it" secondary={{ label: 'DM us on Instagram', href: SITE.instagram.dm }} />
</Base>
<style>
  .cat-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 70px; align-items: center; }
  .cat-copy { text-align: left; }
  .cat-items { list-style: none; padding: 0; margin-top: 40px; border-top: 2px solid var(--ink); }
  .cat-items li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 24px; align-items: baseline; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .cat-items h3 { font-size: clamp(1.8rem, 1rem + 1.6vw, 2.6rem); line-height: 0.95; }
  .cat-items p { color: var(--muted); }
  .cat-items h3 a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .cat-items h3 a:hover { color: var(--accent); }
  .cat-photo { position: relative; margin: 0; aspect-ratio: 4 / 5; border-radius: 8px; overflow: hidden; border: 3px solid var(--accent); rotate: 1.5deg; }
  .cat-photo img { width: 100%; height: 100%; object-fit: cover; }
  .cat-photo figcaption { position: absolute; left: 20px; bottom: 20px; rotate: -4deg; }
  .steps { background: var(--card); border-block: 1px solid var(--line); }
  .step-list { list-style: none; padding: 0; margin-top: 50px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .step-list li { display: flex; flex-direction: column; gap: 10px; padding: 28px; border: 1px solid var(--line); border-radius: 8px; background: var(--deep); text-align: left; }
  .step-list .poster { font-size: 56px; line-height: 1; color: var(--accent); }
  .step-list p { color: var(--muted); }
  .tlink { color: var(--accent); }
  .more-list { list-style: none; padding: 0; margin-top: 24px; display: flex; flex-wrap: wrap; gap: 12px; }
  .more-list a { display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 20px; border: 2px solid var(--ink); border-radius: 4px; font-family: var(--f-display); font-weight: 900; text-transform: uppercase; font-size: 22px; text-decoration: none; color: var(--ink); }
  .more-list a:hover { background: var(--ink); color: var(--deep); }
  .more-list a.web { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .more-list svg { width: 18px; height: 18px; }
  @media (max-width: 1000px) { .cat-grid { grid-template-columns: 1fr; gap: 40px; } .cat-photo { max-width: 460px; margin: 0 auto; width: 100%; } .step-list { grid-template-columns: 1fr; } }
  @media (max-width: 900px) { .cat-copy { text-align: center; } .cat-items li { grid-template-columns: 1fr; gap: 6px; text-align: left; } .more-list { justify-content: center; } }
</style>
