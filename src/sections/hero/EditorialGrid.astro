---
// Hero / EditorialGrid. Magazine grid: a light headline on the left with the emphasis phrase (the service, the
// keyword) carrying a CSS only highlighter moment, two photos of different sizes offset across the right columns,
// generous air, one proof counter. Light ground. The headline renders complete at first paint.
// Fingerprint: layout offset-grid, headline light-with-highlight, density medium, background card-plain, effect keyword-highlighter, mood calm.
// Best for: Editorial, Intentional minimalism. Spa and beauty, PT and clinics, painting and remodeling.
import type { SectionProps } from '../types';
import Proof from '../../components/Proof.astro';
import Actions from '../../components/Actions.astro';
import MaskReveal from '../../effects/MaskReveal.astro';
import CounterRoll from '../../effects/CounterRoll.astro';
import Keyword from '../../effects/Keyword.astro';
import { SITE } from '../../data/site';
interface Props extends SectionProps { media2?: SectionProps['media']; count?: number; countLabel?: string; kicker?: boolean; keywordVariant?: 'highlighter' | 'underline' | 'fill' }
const { eyebrow = `${SITE.category} in ${SITE.city}, ${SITE.region}`, headline = 'Physical therapy that gets you', emphasis = 'moving again', line = 'One on one sessions, a plan written for your goal and the same therapist every visit.', proof, primary = { label: 'Book a first visit', href: '/contact' }, secondary, media = { label: 'Client photo, 4:5' }, media2 = { label: 'Detail photo, square' }, count, countLabel = 'years in the area', kicker = true, keywordVariant = 'highlighter', id } = Astro.props;
---
<section class="hero hero-editorial ground-card" id={id}>
  <div class="wrap hero-grid">
    <div class="stack hero-copy">
      {kicker ? <h1 class="crumb">{eyebrow}</h1> : <span class="eyebrow">{eyebrow}</span>}
      {kicker ? <p class="h1 editorial-h1" data-keyword={emphasis}>{headline} <Keyword text={emphasis} variant={keywordVariant} /></p> : <h1 class="h1 editorial-h1" data-keyword={emphasis}>{headline} <Keyword text={emphasis} variant={keywordVariant} /></h1>}
      <p class="lede">{line}</p>
      <Proof text={proof} />
      <Actions primary={primary} secondary={secondary} />
    </div>
    <div class="hero-photos">
      <div class="p1"><MaskReveal src={media.src} alt={media.alt} label={media.label} shape="arch" /></div>
      <div class="p2"><MaskReveal src={media2.src} alt={media2.alt} label={media2.label} shape="square" delay={0.2} /></div>
      {count !== undefined && <div class="p3"><CounterRoll value={count} label={countLabel} /></div>}
    </div>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding: calc(var(--s-9) + 40px) 0 var(--s-8); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; width: 100%; }
  .hero-copy { max-width: 540px; gap: var(--s-5); }
  .editorial-h1 { font-weight: var(--w-display-light); }
  .editorial-h1 :global(.fx-kw) { font-weight: var(--w-display); }
  .hero-photos { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-template-rows: repeat(6, minmax(0, auto)); gap: var(--s-4); }
  .p1 { grid-column: 1 / 5; grid-row: 1 / 6; }
  .p2 { grid-column: 4 / 7; grid-row: 4 / 7; }
  .p2 :global(.frame) { border: 6px solid var(--card); }
  .p3 { grid-column: 5 / 7; grid-row: 1 / 3; align-self: start; justify-self: end; }
  @media (max-width: 900px) {
    .hero { padding-top: calc(var(--s-8) + 48px); }
    .hero-grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .hero-photos { order: -1; max-width: 420px; margin: 0 auto; }
    .p1 :global(.frame) { max-height: 36vh; }
  }
</style>
