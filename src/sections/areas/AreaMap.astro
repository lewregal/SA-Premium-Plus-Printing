---
// Areas / AreaMap. A map card beside the area copy. Ships a self hosted static map image with the brand pin
// (no API key, one request); pass `embed` to swap in a lazy Google Maps iframe behind a tap to load facade,
// as on the Kissed by the Caribbean area pages. Fingerprint: layout split-right-map, headline bold-solid, density medium,
// background card-plain, effect none, mood steady. Best for: area pages, the contact page.
import { SITE, directionsUrl } from '../../data/site';
interface Props { eyebrow?: string; headline?: string; line?: string; area?: string; embed?: string; image?: string; id?: string }
const { eyebrow = 'Service area', headline = `Roofing near ${SITE.areas[0]}, ${SITE.region}`, line = 'We are on this side of town most weeks. Call for the next open slot or book online.', area = SITE.areas[0], embed, image = '/placeholders/map.svg', id } = Astro.props;
const title = `Map of the ${area}, ${SITE.region} service area`;
---
<section class="sec ground-card" id={id}>
  <div class="wrap split">
    <div class="stack" style="max-width: 520px">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="h2">{headline}</h2>
      <p class="measure">{line}</p>
      <a class="tlink" href={directionsUrl()} rel="noopener">Open in Google Maps <span aria-hidden="true">&rarr;</span></a>
    </div>
    {embed ? (
      <div class="area-map is-deferred" data-map-src={embed} data-map-title={title}>
        <button class="area-map-facade" type="button" aria-label={`Load the map of ${area}, ${SITE.region}`}>
          <span class="area-map-name">{area}, {SITE.region}</span>
          <span class="area-map-hint">Tap to load the map</span>
        </button>
      </div>
    ) : (
      <a class="area-map" href={directionsUrl()} rel="noopener" aria-label={title}>
        <img src={image} alt={title} width="800" height="600" loading="lazy" decoding="async" />
      </a>
    )}
  </div>
</section>
<script>
  const swap = (box: HTMLElement) => {
    if (!box.dataset.mapSrc) return;
    const f = document.createElement('iframe');
    f.src = box.dataset.mapSrc; f.title = box.dataset.mapTitle || 'Service area map'; f.referrerPolicy = 'strict-origin-when-cross-origin'; f.allowFullscreen = true;
    f.addEventListener('load', () => box.classList.add('is-live'), { once: true });
    delete box.dataset.mapSrc; box.appendChild(f);
  };
  document.querySelectorAll<HTMLElement>('.area-map.is-deferred').forEach((b) => b.querySelector('.area-map-facade')?.addEventListener('click', () => swap(b), { once: true }));
</script>
<style>
  .area-map { position: relative; display: block; width: 100%; aspect-ratio: 4 / 3; border-radius: var(--r-media); overflow: hidden; border: 1px solid var(--line); background: var(--paper); box-shadow: var(--shadow-1); }
  .area-map img, .area-map :global(iframe) { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .area-map-facade { position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; width: 100%; border: 0; cursor: pointer; color: var(--brand); font: inherit; background: var(--paper) var(--tx-pattern) 0 0 / var(--tx-pattern-size); transition: opacity var(--t-slow) var(--ease), visibility var(--t-slow); }
  .area-map-name { font-family: var(--f-display); font-weight: var(--w-display); font-size: 28px; }
  .area-map-hint { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .area-map.is-live .area-map-facade { opacity: 0; visibility: hidden; }
  @media (max-width: 900px) { .area-map { aspect-ratio: 1; max-width: 520px; margin: 0 auto; } }
</style>
