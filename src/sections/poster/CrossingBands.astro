---
// Marquee / CrossingBands. Harvest candidate from SA Premium Plus Printing (Nov 2026). The marquee band directly
// below the hero: two tilted caution tape rows crossing, the top one solid green, the lower one outlined, moving in
// opposite directions (translateX only, CSS). No pause button (Lou, 2026-11-22); hover and focus still pause them.
// Reduced motion: both rows sit still. The words are also listed once for screen readers.
// Fingerprint: layout row-strip, headline none, density low, background deep-plain, effect marquee, mood bold.
interface Props { top: string[]; bottom: string[]; label?: string }
const { top, bottom, label = 'What we print' } = Astro.props;
const twice = (a: string[]) => [...a, ...a, ...a, ...a].slice(0, Math.max(12, a.length * 2));
---
<section class="xbands" aria-label={label} data-xbands>
  <ul class="sr-only">{top.map((t) => <li>{t}</li>)}</ul>
  <div class="xb a" aria-hidden="true"><div class="in">{[...twice(top), ...twice(top)].map((t) => <><span>{t}</span><svg><use href="#i-burst"/></svg></>)}</div></div>
  <div class="xb b" aria-hidden="true"><div class="in">{[...twice(bottom), ...twice(bottom)].map((t) => <><span>{t}</span><svg><use href="#i-star"/></svg></>)}</div></div>
</section>
<style>
  .xbands { position: relative; height: 190px; overflow: hidden; background: var(--deep); }
  .xb { position: absolute; left: -5%; width: 110%; overflow: hidden; }
  .xb .in { display: flex; gap: 36px; width: max-content; padding: 14px 0; align-items: center; font-family: var(--f-display); font-weight: 900; font-size: 40px; line-height: 1; text-transform: uppercase; white-space: nowrap; }
  .xb .in svg { width: 24px; height: 24px; flex: none; }
  .xb.a { top: 30px; background: var(--accent); color: var(--accent-ink); rotate: -3deg; }
  .xb.b { top: 92px; background: var(--deep); border-block: 2px solid var(--accent); color: var(--accent); rotate: 2deg; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.motion) .xb .in { animation: xb-mq 34s linear infinite; }
    :global(html.motion) .xb.b .in { animation-direction: reverse; }
    :global(html.motion) .xbands:hover .in, :global(html.motion) .xbands:focus-within .in { animation-play-state: paused; }
  }
  @keyframes xb-mq { to { transform: translateX(-50%); } }
  @media (max-width: 600px) { .xbands { height: 150px; } .xb .in { font-size: 30px; } .xb.b { top: 78px; } }
</style>
