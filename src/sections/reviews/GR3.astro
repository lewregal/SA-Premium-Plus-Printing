---
// Reviews / GR3 (wall). Light paper ground, a centered head with the Google rating line (G, rating, stars, count),
// then a masonry wall of review cards (CSS columns: 3, 2, 1) with an initial badge, the name, stars and the review
// with its key phrase marked. Reads as volume: many voices at a glance. No JS. With no reviews it shows the
// "read them on Google" card. Fingerprint: layout masonry-wall, headline bold-solid, density high, background
// paper-pattern, effect none, mood warm. Best for: a client with many short reviews; reviews page or lower home.
import { SITE } from '../../data/site';
import { REVIEWS, type Review } from '../../data/reviews';
import GoogleG from './GoogleG.astro';
import { marked } from './highlight';
// `sample` (kit only) shows the rating block with bracketed placeholders so the layout can be judged before a client has numbers.
interface Props { eyebrow?: string; headline?: string; reviews?: Review[]; id?: string; sample?: boolean }
const { eyebrow = 'Google reviews', headline = 'In their own words', reviews = REVIEWS, id, sample = false } = Astro.props;
const n: number | string = SITE.reviewCount > 0 ? SITE.reviewCount : sample ? '[N]' : 0;
const rating = SITE.reviewCount > 0 ? SITE.rating : '[0.0]';
const star = 'M8 1l2.1 4.4 4.8.6-3.5 3.3.9 4.7L8 11.7 3.7 14l.9-4.7L1.1 6l4.8-.6z';
const stars = [0, 1, 2, 3, 4].map((i) => `<path transform="translate(${i * 19} 0)" d="${star}"/>`).join('');
const initial = (a: string) => (a.replace(/[^A-Za-z]/g, '')[0] || 'G').toUpperCase();
---
<section class="sec ground-paper gr3" id={id}>
  <div class="wrap">
    <div class="sec-head gr3-head">
      <span class="eyebrow pill">{eyebrow}</span>
      <h2 class="h2">{headline}</h2>
      {n !== 0 && (
        <p class="gr3-line"><GoogleG size={22} /><strong>{rating}</strong><svg width="92" height="16" viewBox="0 0 92 16" role="img" aria-label={`Rated ${rating} out of 5`}><g fill="var(--star)" set:html={stars} /></svg><span>{n} Google reviews</span></p>
      )}
    </div>
    {reviews.length === 0 ? (
      <div class="card gr3-empty"><p>Read what customers say on our Google profile, in their own words.</p></div>
    ) : (
      <ul class="gr3-wall">
        {reviews.map((r) => (
          <li class="gr3-card">
            <div class="gr3-top">
              <span class="gr3-av" aria-hidden="true">{initial(r.author)}</span>
              <span class="gr3-name"><strong>{r.author}</strong><span>{r.when || r.service || 'Google review'}</span></span>
              <GoogleG size={20} />
            </div>
            <svg width="92" height="16" viewBox="0 0 92 16" role="img" aria-label="5 out of 5 stars"><g fill="var(--star)" set:html={stars} /></svg>
            <blockquote><p>{marked(r.text, r.highlight).map((s) => (s.m ? <mark>{s.t}</mark> : s.t))}</p></blockquote>
          </li>
        ))}
      </ul>
    )}
    <div class="btnrow gr3-cta"><a class="btn btn-primary" href={SITE.googleReviews} rel="noopener">{n !== 0 ? `Read all ${n} reviews on Google` : 'Read our reviews on Google'}</a></div>
  </div>
</section>
<style>
  .gr3-head { text-align: center; align-items: center; margin-left: auto; margin-right: auto; }
  .gr3-line { display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 10px; margin: 0; font-weight: var(--w-strong); color: var(--ink); }
  .gr3-line strong { font-size: 22px; }
  .gr3-line span { color: var(--muted); }
  .gr3-wall { list-style: none; margin: 0; padding: 0; columns: 3 300px; column-gap: 24px; }
  .gr3-card { break-inside: avoid; margin: 0 0 24px; background: var(--card); border: 1px solid var(--line); border-radius: var(--r-card); padding: 24px; display: grid; gap: 14px; }
  .gr3-top { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; }
  .gr3-av { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--brand); color: var(--on-deep-strong); font-weight: var(--w-strong); }
  .gr3-name { display: grid; line-height: 1.3; }
  .gr3-name span { font-size: 14px; color: var(--muted); }
  .gr3-card blockquote { margin: 0; }
  .gr3-card blockquote p { margin: 0; line-height: 1.65; color: var(--ink); }
  .gr3-card mark { background: linear-gradient(transparent 58%, color-mix(in srgb, var(--star) 38%, transparent) 58%); color: inherit; font-weight: var(--w-strong); }
  .gr3-empty { max-width: 640px; margin: 0 auto; }
  .gr3-cta { justify-content: center; margin-top: var(--s-6); }
</style>
