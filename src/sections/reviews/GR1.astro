---
// Reviews / GR1 (carousel). Deep ground: eyebrow, headline, the Google rating block (G tile, big rating, stars, count)
// and one button to the profile on the left; a swipeable row of white review cards on the right with the key phrase
// marked, prev and next buttons and progress segments. Native scroll snap, so it works with no JS; the buttons and
// segments are a progressive layer. With no reviews the cards are replaced by the "read them on Google" card, and
// with reviewCount 0 the count and rating are left out. Fingerprint: layout split-right-carousel, headline
// bold-solid, density medium, background deep-grain, effect scroll-snap, mood steady. Best for: home page proof
// band. A `bg` slot takes client art behind everything (Lending a Hand: a rising candlestick chart). First built for Castroville Physical Therapy (2026-11), harvested 2026-11-12.
import { SITE } from '../../data/site';
import { REVIEWS, type Review } from '../../data/reviews';
import GoogleG from './GoogleG.astro';
import { marked } from './highlight';
// `sample` (kit only) shows the rating block with bracketed placeholders so the layout can be judged before a client has numbers.
interface Props { eyebrow?: string; headline?: string; reviews?: Review[]; id?: string; sample?: boolean }
const { eyebrow = 'Google reviews', headline = 'Why neighbors keep coming back', reviews = REVIEWS, id, sample = false } = Astro.props;
const n: number | string = SITE.reviewCount > 0 ? SITE.reviewCount : sample ? '[N]' : 0;
const rating = SITE.reviewCount > 0 ? SITE.rating : '[0.0]';
const star = 'M8 1l2.1 4.4 4.8.6-3.5 3.3.9 4.7L8 11.7 3.7 14l.9-4.7L1.1 6l4.8-.6z';
const stars = (w: number) => [0, 1, 2, 3, 4].map((i) => `<path transform="translate(${i * w} 0)" d="${star}"/>`).join('');
---
<section class="sec ground-deep on-dark gr1" id={id}>
  {Astro.slots.has('bg') && <div class="gr1-bg" aria-hidden="true"><slot name="bg" /></div>}
  <div class="wrap gr1-inner">
    <div class="gr1-copy stack">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="h2">{headline}</h2>
      {n !== 0 && (
        <div class="gr1-rating">
          <span class="gr1-g"><GoogleG size={34} /></span>
          <strong class="gr1-num">{rating}</strong>
          <span class="gr1-meta">
            <svg width="112" height="18" viewBox="0 0 92 16" role="img" aria-label={`Rated ${rating} out of 5`}><g fill="var(--star)" set:html={stars(19)} /></svg>
            <span>{n} Google reviews</span>
          </span>
        </div>
      )}
      <div class="btnrow"><a class="btn btn-primary" href={SITE.googleReviews} rel="noopener">{n !== 0 ? `Read all ${n} reviews on Google` : 'Read our reviews on Google'}</a></div>
    </div>
    <div class="gr1-rail">
      {reviews.length === 0 ? (
        <div class="gr1-card"><p>Read what customers say on our Google profile, in their own words.</p></div>
      ) : (
        <>
          <ul class="gr1-track" tabindex="0" aria-label="Google reviews, scroll sideways for more">
            {reviews.map((r) => (
              <li class="gr1-card">
                <svg width="92" height="16" viewBox="0 0 92 16" role="img" aria-label="5 out of 5 stars"><g fill="var(--star)" set:html={stars(19)} /></svg>
                <blockquote><p>&ldquo;{marked(r.text, r.highlight).map((s) => (s.m ? <mark>{s.t}</mark> : s.t))}&rdquo;</p></blockquote>
                <p class="gr1-who"><strong>{r.author}</strong><span>Google review{r.service && `, ${r.service}`}{!r.service && r.when && `, ${r.when}`}</span></p>
              </li>
            ))}
          </ul>
          <div class="gr1-ctrl" hidden>
            <button type="button" class="gr1-btn" data-dir="-1" aria-label="Previous review"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
            <span class="gr1-segs" aria-hidden="true">{reviews.map(() => <i></i>)}</span>
            <button type="button" class="gr1-btn" data-dir="1" aria-label="Next review"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
          </div>
        </>
      )}
    </div>
  </div>
</section>
<script>
  for (const sec of document.querySelectorAll<HTMLElement>('.gr1')) {
    const track = sec.querySelector<HTMLElement>('.gr1-track');
    const ctrl = sec.querySelector<HTMLElement>('.gr1-ctrl');
    if (!track || !ctrl) continue;
    ctrl.hidden = false;
    const cards = [...track.children] as HTMLElement[];
    const segs = [...sec.querySelectorAll<HTMLElement>('.gr1-segs i')];
    const [prev, next] = [...ctrl.querySelectorAll<HTMLButtonElement>('.gr1-btn')];
    const smooth = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    const step = () => (cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth);
    const sync = () => {
      const i = Math.round(track.scrollLeft / step());
      segs.forEach((s, k) => s.classList.toggle('on', k === i));
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    ctrl.querySelectorAll<HTMLButtonElement>('.gr1-btn').forEach((b) => b.addEventListener('click', () => track.scrollBy({ left: step() * Number(b.dataset.dir), behavior: smooth as ScrollBehavior })));
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    sync();
  }
</script>
<style>
  .gr1 { position: relative; isolation: isolate; overflow: hidden; }
  .gr1-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .gr1-inner { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-8); align-items: center; }
  .gr1-copy { gap: var(--s-5); max-width: 520px; }
  .gr1-rating { display: flex; align-items: center; gap: 18px; }
  .gr1-g { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 16px; background: #fff; flex: none; }
  .gr1-num { font-size: clamp(56px, 6vw, 84px); line-height: 0.9; letter-spacing: -0.04em; color: var(--star); font-weight: 800; }
  .gr1-meta { display: grid; gap: 8px; color: var(--on-deep-strong); font-weight: var(--w-strong); }
  .gr1-rail { min-width: 0; }
  .gr1-track { list-style: none; margin: 0; padding: 4px 4px var(--s-5); display: grid; grid-auto-flow: column; grid-auto-columns: min(400px, 82%); gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent); mask-image: linear-gradient(90deg, #000 85%, transparent); }
  .gr1-track::-webkit-scrollbar { display: none; }
  .gr1-track:focus-visible { outline: 2px solid var(--on-deep-strong); outline-offset: 4px; }
  .gr1-card { scroll-snap-align: start; display: flex; flex-direction: column; gap: 18px; background: #fff; color: var(--ink); border-radius: 28px; padding: 32px; box-shadow: var(--shadow-1); }
  .gr1 .gr1-card p { color: var(--ink); }
  .gr1-card blockquote { margin: 0; flex: 1; }
  .gr1-card blockquote p { margin: 0; font-size: 18px; line-height: 1.65; }
  .gr1-card mark { background: linear-gradient(transparent 58%, color-mix(in srgb, var(--star) 38%, transparent) 58%); color: inherit; font-weight: var(--w-strong); padding: 0 1px; }
  .gr1-who { margin: 0; display: grid; gap: 4px; padding-top: 18px; border-top: 1px solid var(--line); }
  .gr1 .gr1-who span { color: var(--muted); font-size: 15px; }
  .gr1-ctrl { display: flex; align-items: center; gap: 18px; margin-top: var(--s-4); }
  .gr1-ctrl[hidden] { display: none; }
  .gr1-btn { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: transparent; border: 1px solid color-mix(in srgb, var(--on-deep) 55%, transparent); color: var(--on-deep-strong); cursor: pointer; transition: background-color 0.2s, opacity 0.2s; }
  .gr1-btn svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .gr1-btn:hover:not(:disabled) { background: color-mix(in srgb, var(--on-deep) 14%, transparent); }
  .gr1-btn:disabled { opacity: 0.35; cursor: default; }
  .gr1-segs { display: flex; gap: 6px; }
  .gr1-segs i { width: 10px; height: 4px; border-radius: 4px; background: color-mix(in srgb, var(--on-deep) 40%, transparent); transition: width 0.25s, background-color 0.25s; }
  .gr1-segs i.on { width: 30px; background: var(--star); }
  @media (prefers-reduced-motion: reduce) { .gr1-track { scroll-behavior: auto; } .gr1-segs i, .gr1-btn { transition: none; } }
  @media (max-width: 980px) {
    .gr1-inner { grid-template-columns: 1fr; gap: var(--s-7); }
    .gr1-copy { margin: 0 auto; text-align: center; align-items: center; }
    .gr1-rating { justify-content: center; }
    .gr1-ctrl { justify-content: center; }
    .gr1-card { padding: 26px; border-radius: 22px; }
    .gr1-card blockquote p { font-size: 17px; }
  }
  @media (max-width: 480px) { .gr1-g { width: 52px; height: 52px; } .gr1-rating { gap: 12px; } }
</style>
