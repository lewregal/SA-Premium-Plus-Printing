---
// Footer with the full treatment (rigal-design-rules, 2026-11-07): centered on phones, columns on desktop, text only
// pill titles, one map card per location linking to Google Maps. SA Premium: green logo on Ink, the category tree
// as the Shop column, hours and the Instagram handle.
import { SITE, directionsUrl } from '../data/site';
import { ALL } from '../data/categories';
import { CONFIG } from '../site.config';
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="wrap foot-top">
    <div class="foot-brand">
      <img src={SITE.logo} alt={SITE.name} width="360" height="281" loading="lazy" decoding="async">
      <p class="measure">Custom printing in {SITE.city}. Shirts, transfers, stickers, signs and websites.</p>
    </div>
    <div class="foot-col">
      <span class="foot-pill">Shop</span>
      {ALL.map((c) => <a href={`/${c.slug}`}>{c.label}</a>)}
    </div>
    <div class="foot-col">
      <span class="foot-pill">Visit</span>
      <span>{SITE.address.street}</span>
      <span>{SITE.address.city}, {SITE.address.region} {SITE.address.zip}</span>
      <span class="foot-hours">Mon to Fri 11 AM to 7 PM</span>
      <span class="foot-hours">Sat 12 PM to 3 PM</span>
    </div>
    <div class="foot-col">
      <span class="foot-pill">Reach us</span>
      <a href={`tel:${SITE.phoneE164}`}>{SITE.phone}</a>
      <a href={SITE.instagram.href} rel="noopener">{SITE.instagram.handle}</a>
      {CONFIG.booking.enabled && <a href="/book">{CONFIG.booking.label}</a>}
      <a href="/contact">Contact page</a>
    </div>
  </div>
  <div class="wrap foot-maps">
    {SITE.locations.map((loc) => (
      <a class="map-card" href={directionsUrl(loc)} target="_blank" rel="noopener">
        <span class="map-thumb"><img src={loc.map} alt={`Map showing ${loc.name}`} width="400" height="300" loading="lazy" decoding="async"></span>
        <span class="map-body">
          <strong>{loc.name}</strong>
          <span>{loc.street}<br>{loc.city}</span>
          <span>{loc.phone}</span>
          <span class="map-go">Open in Google Maps</span>
        </span>
      </a>
    ))}
  </div>
  <div class="wrap foot-base">
    <span>&copy; {year} {SITE.name}</span>
    <a class="credit" href="https://rigalmedia.com" rel="noopener">Website by Rigal Media</a>
  </div>
</footer>

<style>
  .site-footer { background: var(--deep); border-top: 1px solid var(--line); padding: var(--s-9) 0 var(--s-6); }
  .foot-top { display: grid; grid-template-columns: minmax(0, 1.3fr) repeat(3, minmax(0, 1fr)); gap: var(--s-7) var(--s-6); align-items: start; }
  .foot-brand { display: flex; flex-direction: column; gap: var(--s-4); }
  .foot-brand img { height: 66px; width: auto; }
  .foot-brand p { color: var(--muted); max-width: 32ch; }
  .foot-col { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; font-size: 15px; color: var(--muted); }
  .foot-col a { color: var(--muted); text-decoration: none; padding: 2px 0; }
  @media (max-width: 1100px) { .foot-col a { min-height: 44px; min-width: 44px; justify-content: center; display: inline-flex; align-items: center; } .foot-col { gap: 0; } .credit { min-height: 44px; display: inline-flex; align-items: center; margin: 0; } }
  .foot-col a:hover { color: var(--accent); }
  .foot-pill { display: inline-flex; align-items: center; padding: 6px 12px; margin-bottom: 8px; border-radius: var(--r-pill); border: 1px solid rgb(255 255 255 / 0.22); color: var(--ink); font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; line-height: 1; }
  .foot-maps { display: flex; flex-wrap: wrap; gap: var(--s-5); margin-top: var(--s-8); }
  .map-card { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: var(--s-4); align-items: center; width: min(100%, 440px); padding: 12px; border-radius: var(--r-card); border: 1px solid var(--line); background: var(--card); color: var(--on-deep); text-decoration: none; transition: transform var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease); }
  .map-card:hover { transform: translateY(-3px); border-color: var(--accent); color: var(--on-deep); }
  .map-thumb { display: block; aspect-ratio: 4 / 3; border-radius: 6px; overflow: hidden; }
  .map-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .map-body { display: flex; flex-direction: column; gap: 4px; font-size: 14px; line-height: 1.4; }
  .map-body strong { color: var(--ink); font-size: 15px; }
  .map-go { margin-top: 6px; color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .foot-base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin-top: var(--s-8); padding-top: var(--s-5); border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
  .credit { color: var(--muted); display: inline-block; padding: 8px 0; margin: -8px 0; }
  @media (max-width: 1100px) { .foot-top { grid-template-columns: repeat(2, minmax(0, 1fr)); } .foot-brand { grid-column: 1 / -1; } }
  @media (max-width: 900px) {
    .site-footer { text-align: center; }
    .foot-top { grid-template-columns: 1fr; justify-items: center; }
    .foot-brand, .foot-col { align-items: center; }
    .foot-brand p { margin: 0 auto; }
    .foot-maps { justify-content: center; }
    .map-card { grid-template-columns: 1fr; text-align: center; }
    .foot-base { flex-direction: column; align-items: center; }
  }
</style>
